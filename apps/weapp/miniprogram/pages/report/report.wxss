.disclaimer-banner {
  position: sticky;
  top: 0;
  z-index: 3;
  padding: 32rpx 32rpx 36rpx;
  background: var(--color-primary-soft);
  color: var(--color-ink);
}

.disclaimer-kicker {
  display: block;
  color: var(--color-primary-ink);
  font-size: var(--type-display);
  font-weight: 600;
  line-height: 1.2;
}

.disclaimer-body {
  display: block;
  margin-top: 16rpx;
  color: var(--color-ink-secondary);
  font-size: var(--type-body);
  font-weight: 600;
  line-height: 1.65;
}

.page {
  padding: 36rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
}

.title {
  display: block;
  font-size: var(--type-title);
  font-weight: 600;
  line-height: 1.25;
}

.section {
  margin-top: 36rpx;
}

.section-title {
  display: block;
  color: var(--color-ink);
  font-size: var(--type-section);
  font-weight: 600;
}

.section-note {
  display: block;
  margin-top: 8rpx;
  color: var(--color-muted);
  font-size: var(--type-caption);
}

.card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.card-title {
  flex: 1;
  font-size: var(--type-card-title);
  font-weight: 600;
}

.tag {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary-soft);
  color: var(--color-ink-secondary);
  font-size: var(--type-index);
}

.card-body,
.related {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--type-reading);
  line-height: 1.6;
}

.related {
  font-size: var(--type-caption);
}

.session-note {
  display: block;
  margin-top: 36rpx;
  color: var(--color-muted);
  font-size: var(--type-caption);
  line-height: 1.6;
}

.share-save {
  margin-top: 28rpx;
}

.share-hint {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--type-caption);
  line-height: 1.6;
}

.share-again {
  margin-top: 24rpx;
}

.share-canvas {
  position: fixed;
  left: -2400px;
  top: 0;
  width: 750px;
  height: 1334px;
  pointer-events: none;
}
