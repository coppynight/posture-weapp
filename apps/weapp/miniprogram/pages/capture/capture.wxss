.page {
  padding: 32rpx 32rpx 520rpx;
}

.back-link {
  display: flex;
  align-items: center;
  height: 64rpx;
  margin-bottom: 12rpx;
  color: var(--color-primary-ink);
  font-size: var(--type-reading);
  font-weight: 700;
}

.front-chip {
  display: flex;
  align-items: center;
  width: 100%;
  height: 72rpx;
  margin-bottom: 28rpx;
  padding: 0 28rpx;
  border-radius: var(--radius-pill);
  background: var(--color-line);
  color: var(--color-ink);
  font-size: var(--type-caption);
  font-weight: 700;
}

button[disabled].back-link,
button[disabled].front-chip {
  color: var(--color-muted);
}

.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 28rpx;
}

.step-line {
  width: 36rpx;
  height: 4rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-line);
}

.step-idle {
  width: var(--size-ordinal);
  height: var(--size-ordinal);
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  border: 2rpx solid var(--color-line);
  box-sizing: border-box;
  background: transparent;
  color: var(--color-muted);
  font-size: var(--type-caption);
  font-weight: 700;
  text-align: center;
  line-height: calc(var(--size-ordinal) - 4rpx);
}

.step-name {
  font-size: var(--type-section);
  font-weight: 700;
}

.title {
  display: block;
  font-size: var(--type-title);
  font-weight: 700;
  line-height: 1.25;
}

.guide {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border: 2rpx dashed var(--color-ink-secondary);
  border-radius: var(--radius-control);
}

.guide-text {
  display: block;
  color: var(--color-ink);
  font-size: var(--type-reading);
  line-height: 1.55;
}

.slot {
  margin-top: 24rpx;
  padding: 20rpx;
  background: var(--color-surface);
  border: 2rpx solid var(--color-line);
  border-radius: var(--radius-card);
}

.slot-warn {
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.preview,
.preview-empty {
  width: 100%;
  height: 640rpx;
  border-radius: var(--radius-media);
  background: var(--color-line);
}

.preview-empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-label {
  color: var(--color-ink);
  font-size: var(--type-section);
  font-weight: 700;
}

.slot-actions {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius-control);
  font-size: var(--type-reading);
  font-weight: 700;
}

.btn-ghost {
  flex: 1;
  background: var(--color-bg);
  color: var(--color-ink);
  border: 2rpx solid var(--color-line);
}

.btn-ghost + .btn-ghost {
  margin-left: 16rpx;
}

.btn-text {
  margin-top: 8rpx;
  height: 64rpx;
  color: var(--color-primary-ink);
  font-size: var(--type-caption);
}

.retake {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-primary-soft);
  border-radius: var(--radius-card);
}

.retake-title {
  display: block;
  font-size: var(--type-section);
  font-weight: 700;
  color: var(--color-primary-ink);
}

.retake-lead,
.retake-summary,
.retake-line,
.retake-note,
.check-item {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--type-reading);
  line-height: 1.55;
}

.retake-note {
  color: var(--color-primary-ink);
  font-weight: 700;
}

.checklist-title {
  display: block;
  margin-top: 20rpx;
  font-size: var(--type-reading);
  font-weight: 700;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-line);
}

.guide-bar {
  margin-top: 0;
  margin-bottom: 16rpx;
}

.notice {
  display: block;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--type-reading);
  font-weight: 700;
  line-height: 1.5;
}
