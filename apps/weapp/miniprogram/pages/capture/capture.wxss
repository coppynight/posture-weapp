.page {
  padding: 32rpx 32rpx 420rpx;
}

.hero {
  margin-bottom: 28rpx;
}

.eyebrow {
  display: block;
  color: var(--color-primary-ink);
  font-size: var(--type-caption);
  font-weight: 700;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: var(--type-title);
  font-weight: 700;
  line-height: 1.25;
}

.lead {
  display: block;
  margin-top: 16rpx;
  color: var(--color-muted);
  font-size: var(--type-reading);
  line-height: 1.6;
}

.slot {
  margin-top: 24rpx;
  padding: 28rpx;
  background: var(--color-surface);
  border: 2rpx dashed var(--color-line);
  border-radius: var(--radius-card);
}

.slot-filled {
  border-style: solid;
  border-color: var(--color-line);
}

.slot-warn {
  border-style: solid;
  border-color: var(--color-primary);
  background: var(--color-primary-soft);
}

.slot-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.slot-index {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--type-reading);
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
}

.slot-copy {
  flex: 1;
}

.slot-label {
  display: block;
  font-size: var(--type-section);
  font-weight: 700;
}

.slot-hint {
  display: block;
  margin-top: 4rpx;
  color: var(--color-muted);
  font-size: var(--type-caption);
}

.preview {
  width: 100%;
  height: 420rpx;
  margin-top: 20rpx;
  border-radius: var(--radius-media);
  background: var(--color-line);
}

.slot-actions {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: var(--radius-control);
  font-size: var(--type-reading);
  font-weight: 700;
}

.btn-ghost {
  flex: 1;
  background: var(--color-bg);
  color: var(--color-ink);
}

.btn-ghost + .btn-ghost {
  margin-left: 16rpx;
}

.btn-text {
  margin-top: 12rpx;
  height: 64rpx;
  color: var(--color-primary-ink);
  font-size: var(--type-caption);
}

.retake {
  margin-top: 28rpx;
  padding: 28rpx;
  background: var(--color-primary-soft);
  border-radius: var(--radius-card);
}

.retake-title {
  display: block;
  font-size: var(--type-section);
  font-weight: 700;
  color: var(--color-primary-ink);
}

.retake-lead,
.retake-summary,
.retake-line,
.check-item {
  display: block;
  margin-top: 12rpx;
  color: var(--color-ink-secondary);
  font-size: var(--type-reading);
  line-height: 1.55;
}

.retake-shot {
  margin-top: 18rpx;
}

.retake-shot-label,
.checklist-title {
  display: block;
  margin-top: 8rpx;
  font-size: var(--type-reading);
  font-weight: 700;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 2rpx solid var(--color-line);
}

.notice {
  display: block;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-control);
  background: var(--color-primary-soft);
  color: var(--color-primary-ink);
  font-size: var(--type-reading);
  font-weight: 700;
  line-height: 1.5;
}

.need-both {
  display: block;
  margin-bottom: 14rpx;
  color: var(--color-muted);
  font-size: var(--type-caption);
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--color-primary);
  color: var(--color-on-primary);
  font-size: var(--type-card-title);
  font-weight: 700;
}

.btn-muted {
  background: var(--color-line);
  color: var(--color-muted);
}

button[disabled].btn-primary {
  background: var(--color-line);
  color: var(--color-muted);
}
