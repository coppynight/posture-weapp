.page {
  padding: 32rpx 32rpx 420rpx;
}

.hero {
  margin-bottom: 28rpx;
}

.eyebrow {
  display: block;
  color: #0f6e56;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.25;
}

.lead {
  display: block;
  margin-top: 16rpx;
  color: #5c564c;
  font-size: 28rpx;
  line-height: 1.6;
}

.slot {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #fffdf8;
  border: 2rpx dashed #d9d0c2;
  border-radius: 28rpx;
}

.slot-filled {
  border-style: solid;
  border-color: #e4dccf;
}

.slot-warn {
  border-style: solid;
  border-color: #e08a2c;
  background: #fff8ef;
}

.slot-head {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.slot-index {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #1c1915;
  color: #fffdf8;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  line-height: 56rpx;
}

.slot-copy {
  flex: 1;
}

.slot-label {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.slot-hint {
  display: block;
  margin-top: 4rpx;
  color: #6d675d;
  font-size: 24rpx;
}

.preview {
  width: 100%;
  height: 420rpx;
  margin-top: 20rpx;
  border-radius: 20rpx;
  background: #ebe4d8;
}

.slot-actions {
  display: flex;
  flex-direction: row;
  margin-top: 20rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.btn-ghost {
  flex: 1;
  background: #f3efe6;
  color: #1c1915;
}

.btn-ghost + .btn-ghost {
  margin-left: 16rpx;
}

.btn-text {
  margin-top: 12rpx;
  height: 64rpx;
  color: #8a4b12;
  font-size: 26rpx;
}

.retake {
  margin-top: 28rpx;
  padding: 28rpx;
  background: #fff4e4;
  border-radius: 28rpx;
}

.retake-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #7a3e00;
}

.retake-lead,
.retake-summary,
.retake-line,
.check-item {
  display: block;
  margin-top: 12rpx;
  color: #3f3428;
  font-size: 28rpx;
  line-height: 1.55;
}

.retake-shot {
  margin-top: 18rpx;
}

.retake-shot-label,
.checklist-title {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(243, 239, 230, 0.96);
  box-shadow: 0 -12rpx 32rpx rgba(28, 25, 21, 0.06);
}

.notice {
  display: block;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff1e6;
  color: #7a2e0e;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.need-both {
  display: block;
  margin-bottom: 14rpx;
  color: #5c564c;
  font-size: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  background: #0f6e56;
  color: #f7fffb;
  font-size: 32rpx;
  font-weight: 700;
}

.btn-muted {
  background: #8eaaa2;
}

button[disabled].btn-primary {
  background: #8eaaa2;
  color: #f7fffb;
}
