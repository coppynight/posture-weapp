<view class="page">
  <block wx:if="{{backLabel}}">
    <button class="back-link" disabled="{{submitting}}" bindtap="onBackFront">{{backLabel}}</button>
    <button class="front-chip" disabled="{{submitting}}" bindtap="onBackFront">{{frontChosenLabel}}</button>
  </block>

  <view class="stepper">
    <text wx:if="{{step == 'front'}}" class="ordinal">1</text>
    <text wx:else class="step-idle">1</text>
    <view class="step-line"></view>
    <text wx:if="{{step == 'side'}}" class="ordinal">2</text>
    <text wx:else class="step-idle">2</text>
    <text class="step-name">{{stepLabel}}</text>
  </view>

  <text class="title">{{title}}</text>
  <view class="guide">
    <text class="guide-text">{{guide}}</text>
  </view>

  <view wx:if="{{retake}}" class="retake">
    <text class="retake-title">{{retake.title}}</text>
    <text class="retake-lead">{{retake.lead}}</text>
    <text class="retake-summary">{{retake.summary}}</text>
    <text wx:for="{{retake.messages}}" wx:key="*this" class="retake-line">{{item}}</text>
    <text class="checklist-title">{{retake.checklistTitle}}</text>
    <view wx:for="{{retake.checklist}}" wx:key="*this" class="check-item">{{item}}</view>
    <text wx:if="{{otherRetakeNote}}" class="retake-note">{{otherRetakeNote}}</text>
  </view>

  <view class="slot {{slot.filled ? 'slot-filled' : ''}} {{slot.needsRetake ? 'slot-warn' : ''}}">
    <image wx:if="{{slot.filled}}" class="preview" src="{{slot.preview}}" mode="aspectFill" />
    <view wx:else class="preview preview-empty">
      <text class="preview-label">{{slot.label}}</text>
    </view>
    <view class="slot-actions">
      <button class="btn btn-ghost" disabled="{{submitting}}" data-view="{{slot.view}}" data-source="camera" bindtap="onPick">{{slot.shootLabel}}</button>
      <button class="btn btn-ghost" disabled="{{submitting}}" data-view="{{slot.view}}" data-source="album" bindtap="onPick">{{slot.albumLabel}}</button>
    </view>
    <button wx:if="{{slot.filled}}" class="btn-text" disabled="{{submitting}}" data-view="{{slot.view}}" bindtap="onRemove">{{slot.removeLabel}}</button>
  </view>
</view>

<view class="submit-bar">
  <view class="guide guide-bar">
    <text class="guide-text">{{aside}}</text>
  </view>
  <text wx:if="{{notice}}" class="notice">{{notice}}</text>
  <button wx:if="{{primaryAction == 'next'}}" class="btn-primary {{primaryReady ? '' : 'btn-muted'}}" disabled="{{!primaryReady}}" bindtap="onNext">{{primaryLabel}}</button>
  <button wx:else class="btn-primary {{primaryReady ? '' : 'btn-muted'}}" disabled="{{!primaryReady}}" bindtap="onSubmit">{{primaryLabel}}</button>
</view>
